# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=!

# ── Search ───────────────────────────────────────────────────────────────────
# Brave Search API  — free tier: 2,000 requests/month, no credit card
# Get your key: https://api.search.brave.com/app/keys
SEARCH_PROVIDER=brave
BRAVE_API_KEY=your_brave_api_key_here

# Google Custom Search (alternative — 100 free/day)
# SEARCH_PROVIDER=google_cse
# GOOGLE_CSE_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ID=your_custom_search_engine_id_here

# ── AI — primary + fallback (both keys required) ───────────────────────────────
ACTIVE_AI_PROVIDER=groq
FALLBACK_AI_PROVIDER=openai

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Backup provider keys (only needed if you swap ACTIVE_AI_PROVIDER) ───────────
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here
# CEREBRAS_API_KEY=your_cerebras_key_here
