GEMINI_API_KEY=your_key_here

# ── Gemini Shadow Courtroom (optional — all features degrade gracefully) ──

# OpenRouter API key — enables three AI judge personalities
# Get yours free at https://openrouter.ai
OPENROUTER_API_KEY=

# Google service account credentials (base64-encoded JSON)
# OR path to the credentials JSON file (use one or the other)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=

# Google Doc ID — the courtroom transcript document
# Copy from the Doc URL: docs.google.com/document/d/<GDOC_ID>/edit
GDOC_ID=

# Google Sheet ID — the hourly summary sheet
# Copy from the Sheet URL: docs.google.com/spreadsheets/d/<GSHEET_ID>/edit
GSHEET_ID=

# How often (in hours) to summarise exchanges to Sheets (default: 4)
SUMMARY_INTERVAL_HOURS=4
